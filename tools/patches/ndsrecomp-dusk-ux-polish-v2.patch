+// Small rounded outlines use SDL3 native geometry: the game texture itself
+// is clipped to the same corners, not covered with opaque corner rectangles.
+static std::vector<SDL_FPoint> dusk_round_points(dusk_native::Rect r,float radius) {
+    const float x=float(r.x),y=float(r.y),w=float(r.w),h=float(r.h);
+    const float rad=std::clamp(radius,0.f,std::min(w,h)*.5f);
+    std::vector<SDL_FPoint> points;
+    points.reserve(25);
+    constexpr float pi=3.14159265358979f;
+    for(int corner=0;corner<4;++corner) {
+        const float cx=x+((corner==0||corner==1)?w-rad:rad);
+        const float cy=y+((corner==1||corner==2)?h-rad:rad);
+        const float start=(float(corner)-1.f)*pi*.5f;
+        for(int i=0;i<=5;++i) {
+            const float angle=start+float(i)*pi/10.f;
+            points.push_back({cx+std::cos(angle)*rad,
+                              cy+std::sin(angle)*rad});
+        }
+    }
+    return points;
+}
+static void dusk_round_geometry(SDL_Renderer* renderer,SDL_Texture* texture,
+                                dusk_native::Rect box,int radius,SDL_FColor color) {
+    if(box.w<1 || box.h<1)return;
+    const auto outline=dusk_round_points(box,float(radius));
+    std::vector<SDL_Vertex> vertices;
+    std::vector<int> indices;
+    vertices.reserve(outline.size()+1);
+    indices.reserve(outline.size()*3);
+    const auto add=[&](SDL_FPoint xy) {
+        vertices.push_back({xy,color,{(xy.x-float(box.x))/float(box.w),
+                                      (xy.y-float(box.y))/float(box.h)}});
+    };
+    add({box.x+box.w*.5f,box.y+box.h*.5f});
+    for(auto xy:outline)add(xy);
+    for(int i=0;i<int(outline.size());++i) {
+        indices.push_back(0);
+        indices.push_back(i+1);
+        indices.push_back((i+1)%int(outline.size())+1);
+    }
+    SDL_RenderGeometry(renderer,texture,vertices.data(),int(vertices.size()),
+                       indices.data(),int(indices.size()));
+}
+static void dusk_round_outline(SDL_Renderer* renderer,dusk_native::Rect box,
+                               int radius,uint8_t red,uint8_t green,uint8_t blue) {
+    auto line=dusk_round_points(box,float(radius));
+    line.push_back(line.front());
+    SDL_SetRenderDrawColor(renderer,red,green,blue,255);
+    SDL_RenderLines(renderer,line.data(),int(line.size()));
+}
+static void dusk_render_rounded_screen(FrontendPresentation& p,int screen,
+                                      dusk_native::Rect box,int radius) {
+    SDL_Renderer* r=p.renderers[0];
+    SDL_Texture* tex=p.textures[screen];
+    if(p.sample_scale>1 && p.sample_targets[screen]) {
+        SDL_SetRenderTarget(r,p.sample_targets[screen]);
+        SDL_SetRenderDrawColor(r,0,0,0,255);
+        SDL_RenderClear(r);
+        SDL_RenderTexture(r,tex,nullptr,nullptr);
+        SDL_SetRenderTarget(r,nullptr);
+        tex=p.sample_targets[screen];
+    }
+    dusk_round_geometry(r,tex,box,radius,{1.f,1.f,1.f,1.f});
+}
+static void dusk_cursor_for_pip(FrontendPresentation& p,int edges) {
+    int next=0;
+    using namespace dusk_native;
+    if((edges&EdgeLeft && edges&EdgeTop) ||
+       (edges&EdgeRight && edges&EdgeBottom))next=3;
+    else if((edges&EdgeLeft && edges&EdgeBottom) ||
+            (edges&EdgeRight && edges&EdgeTop))next=4;
+    else if(edges&(EdgeLeft|EdgeRight))next=1;
+    else if(edges&(EdgeTop|EdgeBottom))next=2;
+    if(p.dusk.active_cursor==next)return;
+    if(next==0)SDL_SetCursor(SDL_GetDefaultCursor());
+    else {
+        SDL_Cursor*& cursor=p.dusk.resize_cursors[next-1];
+        if(!cursor) {
+            const SDL_SystemCursor kind=next==1?SDL_SYSTEM_CURSOR_EW_RESIZE:
+                next==2?SDL_SYSTEM_CURSOR_NS_RESIZE:
+                next==3?SDL_SYSTEM_CURSOR_NWSE_RESIZE:
+                        SDL_SYSTEM_CURSOR_NESW_RESIZE;
+            cursor=SDL_CreateSystemCursor(kind);
+        }
+        if(cursor)SDL_SetCursor(cursor);
+    }
+    p.dusk.active_cursor=next;
+}
