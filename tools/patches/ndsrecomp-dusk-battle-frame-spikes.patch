         publish_input_debug();
 
         const uint64_t phase0 = SDL_GetPerformanceCounter();
+        if (nds_diagnostics_enabled() && prior_guest_frame_start) {
+            // Wall-clock presentation gap, including pacing/event handling,
+            // catches a single visually frozen battle-background frame even
+            // when 1-second aggregate FPS averages ~59.8.
+            const uint64_t gap = phase0 - prior_guest_frame_start;
+            if (gap > g_live_stats.max_frame_gap_ticks) {
+                g_live_stats.max_frame_gap_ticks = gap;
+                g_live_stats.max_frame_gap_frame = shown_frames;
+            }
+            if (static_cast<double>(gap) * 1000.0 >
+                static_cast<double>(frequency) * 20.0) {
+                ++g_live_stats.frame_gap_over_20ms;
+                g_live_stats.last_hitch_frame = shown_frames;
+            }
+        }
+        prior_guest_frame_start = phase0;
         const uint64_t now = scheduler_system_timestamp();
         const uint64_t next_frame =
             (now / kSystemCyclesPerFrame + 1u) * kSystemCyclesPerFrame;
@@ -3773,6 +3790,21 @@
         {
             frame_emu_ticks = SDL_GetPerformanceCounter() - phase0;
             phase_emu_ticks += frame_emu_ticks;
