+#if defined(NDS_HAVE_SDL3)
+// Host-only splash: ROM/guest frames, timing and save state are untouched.
+// BMP is generated from approved artwork at build time and integrity-checked
+// by the desktop launcher. SDL3 loads it without another image dependency.
+static bool dusk_show_startup(FrontendPresentation& presentation) {
+    const char* path = std::getenv("NDS_DUSK_SPLASH_PATH");
+    if (!path || !path[0] || !presentation.renderers[0]) return true;
+    SDL_Surface* surface = SDL_LoadBMP(path);
+    if (!surface) {
+        std::fprintf(stderr, "[dusk-splash] unable to load BMP: %s\n", SDL_GetError());
+        return true;  // Degraded appearance must never prevent starting the game.
+    }
+    SDL_Renderer* renderer = presentation.renderers[0];
+    SDL_Texture* texture = SDL_CreateTextureFromSurface(renderer, surface);
+    SDL_DestroySurface(surface);
+    if (!texture) {
+        std::fprintf(stderr, "[dusk-splash] unable to create texture: %s\n", SDL_GetError());
+        return true;
+    }
+    SDL_SetTextureScaleMode(texture, SDL_SCALEMODE_LINEAR);
+    // Five seconds of visible presentation by default. Future cosmetic
+    // releases can alter this bounded value from the launcher alone.
+    uint64_t duration_ms = 5000;
+    if (const char* configured = std::getenv("NDS_DUSK_SPLASH_DURATION_MS")) {
+        char* end = nullptr;
+        const unsigned long requested = std::strtoul(configured, &end, 10);
+        if (end != configured && *end == '\0' && requested >= 4000 && requested <= 15000)
+            duration_ms = requested;
+    }
+    constexpr uint64_t fade_ms = 300;
+    const uint64_t start = SDL_GetTicks();
+    uint64_t paused_total = 0;
+    uint64_t paused_at = 0;
+    bool paused = false;
+    bool cancelled = false;
+    while (true) {
+        const uint64_t now = paused ? paused_at : SDL_GetTicks();
+        if (!paused && now - start - paused_total >= duration_ms) break;
+        SDL_Event event{};
+        while (SDL_PollEvent(&event)) {
+            if (event.type == SDL_EVENT_QUIT ||
+                event.type == SDL_EVENT_WINDOW_CLOSE_REQUESTED) {
+                cancelled = true;
+                break;
+            }
+            // Never dismiss the splash on incidental input. P explicitly
+            // freezes/unfreezes it so the player can inspect the artwork.
+            if (event.type == SDL_EVENT_KEY_DOWN && !event.key.repeat &&
+                event.key.scancode == SDL_SCANCODE_P) {
+                const uint64_t tick = SDL_GetTicks();
+                if (paused) {
+                    paused_total += tick - paused_at;
+                    paused = false;
+                } else {
+                    paused_at = tick;
+                    paused = true;
+                }
+            }
+        }
+        if (cancelled) break;
+        const uint64_t elapsed = (paused ? paused_at : SDL_GetTicks()) -
+                                 start - paused_total;
+        int width = 1280, height = 720;
+        if (!SDL_GetRenderOutputSize(renderer, &width, &height) ||
+            width < 1 || height < 1) {
+            width = 1280;
+            height = 720;
+        }
+        const float scale = std::min(float(width) / 1280.f, float(height) / 720.f);
+        const SDL_FRect destination{
+            (float(width) - 1280.f * scale) * 0.5f,
+            (float(height) - 720.f * scale) * 0.5f,
+            1280.f * scale, 720.f * scale};
+        const uint64_t fade_in = std::min(elapsed, fade_ms);
+        const uint64_t fade_out = std::min(duration_ms - std::min(elapsed, duration_ms), fade_ms);
+        const uint8_t opacity = static_cast<uint8_t>(
+            255u * std::min(fade_in, fade_out) / fade_ms);
+        SDL_SetTextureAlphaMod(texture, opacity);
+        SDL_SetRenderDrawColor(renderer, 7, 11, 30, 255);
+        SDL_RenderClear(renderer);
+        SDL_RenderTexture(renderer, texture, nullptr, &destination);
+        SDL_RenderPresent(renderer);
+        SDL_Delay(16);  // Presentation-only; guest emulation has not started.
+    }
+    SDL_DestroyTexture(texture);
+    return !cancelled;
+}
+#endif
 
