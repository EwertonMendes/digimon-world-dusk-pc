+// PC Options controller navigation lives entirely on the host. The guest DS
+// still ticks normally while its keys/touch remain released.
+enum class MenuDirection : int { None=0, Up, Down, Left, Right };
+struct MenuStickNavigation {
+    MenuDirection held=MenuDirection::None;
+    int frames=0;
+    void reset() {held=MenuDirection::None;frames=0;}
+    MenuDirection poll(float x,float y) {
+        if(!std::isfinite(x) || !std::isfinite(y)) {reset();return MenuDirection::None;}
+        const float ax=std::abs(x),ay=std::abs(y);
+        constexpr float enter=0.55f, leave=0.37f;
+        MenuDirection direction=MenuDirection::None;
+        if(std::max(ax,ay)>enter) {
+            if(ax>ay)direction=x>0.f?MenuDirection::Right:MenuDirection::Left;
+            else direction=y>0.f?MenuDirection::Down:MenuDirection::Up;
+        } else if(held!=MenuDirection::None && std::max(ax,ay)>leave) {
+            if((held==MenuDirection::Right && x>leave) ||
+               (held==MenuDirection::Left && x<-leave) ||
+               (held==MenuDirection::Down && y>leave) ||
+               (held==MenuDirection::Up && y<-leave))direction=held;
+        }
+        if(direction==MenuDirection::None){reset();return direction;}
+        if(direction!=held){held=direction;frames=0;return direction;}
+        ++frames;
+        if(frames==18 || (frames>18 && (frames-18)%5==0))return direction;
+        return MenuDirection::None;
+    }
+};
