+static dusk_native::Rect dusk_menu_panel(const dusk_native::Geometry& g) {
+    const int w=std::min(610,std::max(280,g.play.w-24));
+    const int h=std::min(620,std::max(190,g.play.h-18));
+    return {(g.play.w-w)/2,(g.play.h-h)/2,w,h};
+}
+static const char* dusk_label(int row) {
+    static const char* names[]={"SCREEN LAYOUT","MAIN DISPLAY","AUXILIARY SCREEN",
+        "AUXILIARY SIZE","SCREEN RATIO","WINDOW MODE","PRESENTATION FPS",
+        "PIP POSITION","BACK TO GAME"};
+    return row>=0 && row<9 ? names[row] : "";
+}
+static std::string dusk_value(const FrontendPresentation& p,int row) {
+    const auto& c=p.dusk.cfg;
+    switch(row) {
+        case 0:return dusk_mode_name(c.layout);
+        case 1:return c.focus_top?"UPPER":"LOWER / TOUCH";
+        case 2:return c.auxiliary?"SHOW":"MINIMIZED";
+        case 3:return std::to_string(c.float_percent)+"%";
+        case 4:return c.fill_wide?"16:9 FILL *":"ORIGINAL 4:3";
+        case 5:return c.fullscreen?"FULLSCREEN":"WINDOWED";
+        case 6:return c.half_present?"30 FPS":"60 FPS";
+        case 7:return std::to_string(c.float_corner+1)+" / 4";
+        default:return "";
+    }
+}
+static void dusk_set_fullscreen(FrontendPresentation& p,bool enabled) {
+    if(!p.windows[0])return;
+    if(SDL_SetWindowFullscreen(p.windows[0],enabled))p.dusk.cfg.fullscreen=enabled;
+    else std::fprintf(stderr,"[dusk-ui] fullscreen failed: %s\n",SDL_GetError());
+}
+static void dusk_menu_action(FrontendPresentation& p,int row,int delta) {
+    auto& c=p.dusk.cfg;
+    switch(row) {
+        case 0:c.layout=static_cast<dusk_native::Layout>((int(c.layout)+6+(delta>=0?1:-1))%6);break;
+        case 1:c.focus_top=!c.focus_top;c.layout=dusk_native::Layout::Focus;break;
+        case 2:c.auxiliary=!c.auxiliary;break;
+        case 3:c.float_percent=std::clamp(c.float_percent+(delta>=0?5:-5),25,65);break;
+        case 4:c.fill_wide=!c.fill_wide;break;
+        case 5:dusk_set_fullscreen(p,!c.fullscreen);break;
+        case 6:c.half_present=!c.half_present;break;
+        case 7:c.float_corner=(c.float_corner+4+(delta>=0?1:-1))%4;
+               c.floating_x=-1;c.floating_y=-1;break;
+        default:p.dusk.menu_open=false;break;
+    }
+    dusk_save(p);
+}
+static void dusk_menu(SDL_Renderer* r,const FrontendPresentation& p,
+                      const dusk_native::Geometry& g) {
+    const int w=g.play.w,h=g.play.h;
+    dusk_fill(r,{0,0,w,h},5,4,18,198);
+    const auto panel=dusk_menu_panel(g);
+    dusk_fill(r,panel,30,12,66,251);
+    dusk_fill(r,{panel.x+4,panel.y+4,panel.w-8,panel.h-8},49,17,108,255);
+    dusk_outline(r,panel,182,88,245);
+    dusk_fill(r,{panel.x+12,panel.y+14,panel.w-24,54},86,24,154);
+    if(panel.h>=400) {
+        dusk_text(r,panel.x+26,panel.y+26,"DIGIMON WORLD DUSK",1.65f);
+        dusk_text(r,panel.x+26,panel.y+54,"PC OPTIONS    -    DISPLAY SETTINGS",1.f);
+    } else dusk_text(r,panel.x+20,panel.y+20,"DUSK - PC OPTIONS",1.2f);
+    const int row_y=panel.y+(panel.h<400?52:83);
+    const int step=std::max(11,std::min(43,(panel.h-(panel.h<400?115:145))/9));
+    for(int i=0;i<9;++i) {
+        const int y=row_y+i*step;
+        if(i==p.dusk.selected) {
+            dusk_fill(r,{panel.x+13,y-2,panel.w-26,step-1},121,49,196);
+            dusk_outline(r,{panel.x+13,y-2,panel.w-26,step-1},209,138,250);
+        }
+        dusk_text(r,panel.x+23,y+3,dusk_label(i),panel.h<400?.95f:1.16f);
+        const auto value=dusk_value(p,i);
+        if(!value.empty()) {
+            const float scale=panel.w<400?.82f:1.02f;
+            const int right=panel.x+panel.w-20-int(value.size()*8*scale);
+            dusk_text(r,right,y+3,value.c_str(),scale);
+        }
+    }
+    if(panel.h>=400) {
+        dusk_text(r,panel.x+23,panel.y+panel.h-49,"ARROWS: SELECT    LEFT/RIGHT: CHANGE",.98f);
+        dusk_text(r,panel.x+23,panel.y+panel.h-30,"ENTER: APPLY      ESC/F10: RESUME",.98f);
+        if(p.dusk.cfg.fill_wide)
+            dusk_text(r,panel.x+23,panel.y+panel.h-68,"* 16:9 STRETCHES ORIGINAL 4:3 GAME PIXELS",.84f);
+    } else dusk_text(r,panel.x+16,panel.y+panel.h-26,"ENTER: APPLY    ESC: BACK",.9f);
+}
