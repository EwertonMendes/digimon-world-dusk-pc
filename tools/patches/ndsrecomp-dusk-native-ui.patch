+static const char* dusk_mode_name(dusk_native::Layout l) {
+    switch (l) {
+        case dusk_native::Layout::Modern: return "MODERN";
+        case dusk_native::Layout::Floating: return "FLOATING";
+        case dusk_native::Layout::Classic: return "CLASSIC";
+        case dusk_native::Layout::Horizontal: return "SIDE BY SIDE";
