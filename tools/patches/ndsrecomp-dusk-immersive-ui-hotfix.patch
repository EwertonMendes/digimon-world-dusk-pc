+// Resize touch zones only on the PiP frame; never on the DS guest surface.
+// Side grips have a 10px tolerance, corners combine two axes.
+enum PiPEdge : int { EdgeNone=0, EdgeLeft=1, EdgeRight=2, EdgeTop=4, EdgeBottom=8 };
+inline Rect focus_pip(const Geometry& g,const Config& c) {
+    return c.focus_top ? g.bottom : g.top;
+}
+inline int pip_resize_edges(const Geometry& g,const Config& c,float x,float y) {
+    if(c.layout!=Layout::Focus || !c.auxiliary) return EdgeNone;
+    const auto r=focus_pip(g,c);
+    if(r.w<40 || r.h<40) return EdgeNone;
+    constexpr float outer=5.f,grip=11.f;
+    if(x<r.x-outer || x>=r.x+r.w+outer || y<r.y-outer || y>=r.y+r.h+outer)
+        return EdgeNone;
+    const bool left=std::abs(x-r.x)<=grip;
+    const bool right=std::abs(x-(r.x+r.w))<=grip;
+    const bool top=std::abs(y-r.y)<=grip;
+    const bool bottom=std::abs(y-(r.y+r.h))<=grip;
+    // Leave header action buttons unobstructed. Its left edge still resizes.
+    if(y>=g.pip_swap.y && y<g.pip_swap.y+g.pip_swap.h &&
+       x>=g.pip_swap.x && x<g.pip_minimize.x+g.pip_minimize.w)
+        return EdgeNone;
+    return (left?EdgeLeft:0)|(right?EdgeRight:0)|
+           (top?EdgeTop:0)|(bottom?EdgeBottom:0);
+}
+struct PiPResizeResult { Rect rect{}; int percent=36; };
+inline PiPResizeResult resize_pip(Rect viewport,Rect initial,int edges,
+                                float dx,float dy,int initial_percent) {
+    if(!edges)return {initial,initial_percent};
+    // Prefer the larger motion measured in native DS 4:3 units.
+    const double delta_x=(edges&EdgeLeft)?-dx:(edges&EdgeRight)?dx:0.f;
+    const double delta_y=(edges&EdgeTop)?-dy*4./3.:(edges&EdgeBottom)?dy*4./3.:0.f;
+    const double delta=(edges&(EdgeLeft|EdgeRight)) && (edges&(EdgeTop|EdgeBottom))
+        ? (std::abs(delta_x)>=std::abs(delta_y)?delta_x:delta_y)
+        : delta_x+delta_y;
+    const double basis=std::min(double(viewport.w),double(viewport.h)*4./3.);
+    const int requested=initial.w+int(std::round(delta));
+    const int target_percent=std::clamp(int(std::round(100.0*requested/
+                                                 std::max(1.0,basis))),25,65);
+    // Match the compositor's actual dimension clamping, not just percentage.
+    const int width=std::min(std::clamp(int(basis*target_percent/100.0),96,
+                                     std::max(96,viewport.w/2)),
+                             std::max(96,std::min(viewport.w/2,viewport.h*2/3)));
+    const int height=std::max(1,int(width*192./256.));
+    const int x=(edges&EdgeLeft)?initial.x+initial.w-width:initial.x;
+    const int y=(edges&EdgeTop)?initial.y+initial.h-height:initial.y;
+    return {{std::clamp(x,0,std::max(0,viewport.w-width)),
+             std::clamp(y,0,std::max(0,viewport.h-height)),width,height},target_percent};
+}
 inline bool map_touch(const Geometry& g,float x,float y,float& outx,float& outy) {
     if(!contains(g.bottom,x,y)) return false;
     outx=std::clamp((x-g.bottom.x)*256.f/g.bottom.w,0.f,255.999f);
