+struct RightStickTouch {
+    float x=128.f, y=96.f;
+    bool down=false;
+    // Poll one time per presented guest frame; frame-time-independent speed.
+    // Releasing the stick raises the stylus; mouse retains its own priority.
+    bool step(float rx,float ry,float dt,bool allowed) {
+        const float magnitude=std::sqrt(rx*rx+ry*ry);
+        if(!allowed || !std::isfinite(magnitude) || magnitude<=0.23f) {
+            down=false;
+            return false;
+        }
+        const float normalized=std::clamp((magnitude-0.23f)/0.77f,0.f,1.f);
+        const float velocity=155.f*normalized*normalized;
+        const float time=std::clamp(dt,0.f,0.04f);
+        x=std::clamp(x+rx/magnitude*velocity*time,0.f,255.f);
+        y=std::clamp(y+ry/magnitude*velocity*time,0.f,191.f);
+        down=true;
+        return true;
+    }
