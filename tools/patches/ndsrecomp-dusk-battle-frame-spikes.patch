+                if (emu_ms > 12.0)
+                    ++g_live_stats.emu_over_12ms;
+                if (emu_ms > 1000.0 / 59.8261) {
+                    ++g_live_stats.emu_over_budget;
+                    g_live_stats.last_hitch_frame = shown_frames;
+                }
+            }
             if (frame_emu_ticks > max_emu_ticks) {
                 max_emu_ticks = frame_emu_ticks;
