+static void dusk_save(FrontendPresentation& p) {
+    if(!p.dusk.enabled || p.dusk.config_path.empty()) return;
+    std::ofstream out(p.dusk.config_path,std::ios::trunc);
+    if(!out) { std::fprintf(stderr,"[dusk-ui] settings write failed\n"); return; }
+    const auto& c=p.dusk.cfg;
+    out << 1 << ' ' << int(c.layout) << ' ' << int(c.auxiliary) << ' '
+        << int(c.help) << ' ' << c.float_corner << ' '
+        << c.float_percent << ' ' << c.floating_x << ' ' << c.floating_y << '\n';
+}
+static void dusk_load(FrontendPresentation& p) {
+    p.dusk.enabled=dusk_native_requested();
+    if(!p.dusk.enabled) return;
+    // SDL creates this per-user directory. No admin rights or registry writes.
+    char* path=SDL_GetPrefPath("DuskPC","DigimonWorldDusk");
+    if(!path) return;
+    p.dusk.config_path=std::filesystem::path(path)/"native-layout.cfg";
+    SDL_free(path);
+    std::ifstream in(p.dusk.config_path);
+    int version=0,mode=0,aux=1,help=1,corner=1,percent=36;
+    float fx=-1.f,fy=-1.f;
+    if(in>>version>>mode>>aux>>help>>corner>>percent>>fx>>fy &&
+       version==1 && mode>=0 && mode<=4 && (aux==0||aux==1) &&
+       (help==0||help==1) && corner>=0 && corner<=3 &&
+       percent>=25 && percent<=65 && std::isfinite(fx) && std::isfinite(fy)) {
+        auto& c=p.dusk.cfg;
+        c.layout=static_cast<dusk_native::Layout>(mode);
+        c.auxiliary=aux; c.help=help; c.float_corner=corner;
+        c.float_percent=percent;
+        c.floating_x=std::clamp(fx,-1.f,1.f);
+        c.floating_y=std::clamp(fy,-1.f,1.f);
+    }
+}
