+#pragma once
+// ROM-free, deterministic geometry for Dusk's native SDL3 compositor.
+// This file deliberately knows nothing about SDL, guest RAM, ARM execution or ROM assets.
+#include <algorithm>
+#include <cmath>
+
+namespace dusk_native {
+enum class Layout : int { Modern = 0, Floating = 1, Classic = 2, Horizontal = 3, MainOnly = 4 };
+struct Rect { int x=0, y=0, w=0, h=0; };
+struct Config {
+    Layout layout=Layout::Modern;
+    bool auxiliary=true;
+    bool help=true;
+    int float_corner=1; // 0 left-top, 1 right-top, 2 left-bottom, 3 right-bottom
+    int float_percent=36; // 25..65
+    float floating_x=-1.f, floating_y=-1.f; // normalized within play area, -1 means corner preset
+};
+struct Geometry { Rect top, bottom, toolbar, play; };
+inline Rect fitted(Rect region, int source_w=256, int source_h=192) {
+    if(region.w<=0 || region.h<=0 || source_w<=0 || source_h<=0) return {};
+    const double s=std::min(double(region.w)/source_w,double(region.h)/source_h);
+    const int w=std::max(1,int(std::floor(source_w*s)));
+    const int h=std::max(1,int(std::floor(source_h*s)));
+    return {region.x+(region.w-w)/2,region.y+(region.h-h)/2,w,h};
+}
+inline bool contains(Rect r,float x,float y) {
+    return r.w>0 && r.h>0 && x>=r.x && x<r.x+r.w && y>=r.y && y<r.y+r.h;
+}
+inline Geometry compute(int width,int height,Config cfg, int top_w=256,int bottom_w=256) {
+    const int w=std::max(width,320), h=std::max(height,240);
+    const int pad=std::clamp(w/100,8,24);
+    const int bar=42;
+    const Rect play{pad,bar+pad,w-2*pad,std::max(120,h-bar-2*pad)};
+    Geometry g{}; g.toolbar={0,0,w,bar}; g.play=play;
+    const bool show=cfg.auxiliary && cfg.layout!=Layout::MainOnly;
+    if(!show) { g.bottom=fitted(play,bottom_w,192); return g; }
+    switch(cfg.layout) {
+      case Layout::Modern: {
+        const int sidebar=std::clamp(int(play.w*0.28),180,std::min(460,play.w/2));
+        const Rect primary{play.x,play.y,std::max(1,play.w-sidebar-pad),play.h};
+        const Rect auxiliary{primary.x+primary.w+pad,play.y,sidebar,play.h};
+        g.bottom=fitted(primary,bottom_w,192);
+        g.top=fitted({auxiliary.x,auxiliary.y+std::min(30,play.h/12),auxiliary.w,std::min(play.h*2/3,auxiliary.w*192/std::max(1,top_w)+2)},top_w,192);
+        break;
+      }
+      case Layout::Floating: {
+        g.bottom=fitted(play,bottom_w,192);
+        const int desired=std::clamp(int(play.w*std::clamp(cfg.float_percent,25,65)/100.0),100,play.w/2);
+        const int sw=std::min(desired,std::max(1,play.h*top_w/192/2));
+        const int sh=std::max(1,int(double(sw)*192/std::max(1,top_w)));
+        const int free_x=std::max(0,play.w-sw),free_y=std::max(0,play.h-sh);
+        int x=(cfg.float_corner%2==0)?0:free_x;
+        int y=(cfg.float_corner<2)?0:free_y;
+        if(cfg.floating_x>=0) x=int(std::clamp(cfg.floating_x,0.f,1.f)*free_x);
+        if(cfg.floating_y>=0) y=int(std::clamp(cfg.floating_y,0.f,1.f)*free_y);
+        g.top={play.x+x,play.y+y,sw,sh};
+        break;
+      }
+      case Layout::Classic: {
+        const int gap=std::max(6,pad/2), avail=(play.h-gap)/2;
+        g.top=fitted({play.x,play.y,play.w,avail},top_w,192);
+        g.bottom=fitted({play.x,play.y+avail+gap,play.w,avail},bottom_w,192);
+        break;
+      }
+      case Layout::Horizontal: {
+        const int gap=pad;
+        const int side=(play.w-gap)/2;
+        g.bottom=fitted({play.x,play.y,side,play.h},bottom_w,192);
+        g.top=fitted({play.x+side+gap,play.y,side,play.h},top_w,192);
+        break;
+      }
+      case Layout::MainOnly: break;
+    }
+    return g;
+}
+inline bool map_touch(const Geometry& g,float x,float y,float& outx,float& outy) {
+    if(!contains(g.bottom,x,y)) return false;
+    outx=std::clamp((x-g.bottom.x)*256.f/g.bottom.w,0.f,255.999f);
+    outy=std::clamp((y-g.bottom.y)*192.f/g.bottom.h,0.f,191.999f);
+    return true;
+}
+} // namespace dusk_native
