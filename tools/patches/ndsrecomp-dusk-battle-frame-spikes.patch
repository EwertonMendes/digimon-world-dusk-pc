+                    g_live_stats.max_emu_frame_ticks = frame_emu_ticks;
+                    g_live_stats.max_emu_frame = shown_frames;
+                }
+                const double emu_ms =
+                    static_cast<double>(frame_emu_ticks) * 1000.0 /
