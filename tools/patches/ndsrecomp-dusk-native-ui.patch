+static bool dusk_handle_mouse(FrontendPresentation& p, SDL_Event& ev) {
+    if(!p.dusk.enabled || p.separate) return false;
+    if(ev.type!=SDL_MOUSEBUTTONDOWN && ev.type!=SDL_MOUSEBUTTONUP &&
+       ev.type!=SDL_MOUSEMOTION) return false;
+    float x=0,y=0;
+    bool down=ev.type==SDL_MOUSEBUTTONDOWN;
+    bool up=ev.type==SDL_MOUSEBUTTONUP;
+    if(down||up) {x=ev.button.x;y=ev.button.y;}
+    else {x=ev.motion.x;y=ev.motion.y;}
+    if(!SDL_RenderCoordinatesFromWindow(p.renderers[0],x,y,&x,&y)) return false;
+    const auto g=dusk_geometry(p);
+    if(down && ev.button.button==SDL_BUTTON_LEFT && y<g.toolbar.h) {
+        p.dusk.toolbar_pressed=true;
+        if(x>=240 && x<367) {
+            p.dusk.cfg.layout=static_cast<dusk_native::Layout>((int(p.dusk.cfg.layout)+1)%5);
+        } else if(x>=379 && x<473) {
+            p.dusk.cfg.auxiliary=!p.dusk.cfg.auxiliary;
+        } else if(x>=485 && x<595) {
+            SDL_Window* window=p.windows[0];
+            const bool fullscreen=(SDL_GetWindowFlags(window)&SDL_WINDOW_FULLSCREEN)!=0;
+            SDL_SetWindowFullscreen(window,!fullscreen);
+        } else if(x>=607 && x<689) {
+            p.dusk.cfg.help=!p.dusk.cfg.help;
+        }
+        dusk_save(p);
+        return true;
+    }
+    if(up && p.dusk.toolbar_pressed) {p.dusk.toolbar_pressed=false;return true;}
+    if(up && p.dusk.dragging) {p.dusk.dragging=false;dusk_save(p);return true;}
+    if(p.dusk.dragging && ev.type==SDL_MOUSEMOTION) {
+        const auto next=dusk_geometry(p);
+        const int free_x=std::max(1,next.play.w-next.top.w);
+        const int free_y=std::max(1,next.play.h-next.top.h);
+        p.dusk.cfg.floating_x=std::clamp((x-p.dusk.drag_dx-next.play.x)/free_x,0.f,1.f);
+        p.dusk.cfg.floating_y=std::clamp((y-p.dusk.drag_dy-next.play.y)/free_y,0.f,1.f);
+        return true;
+    }
+    if(down && ev.button.button==SDL_BUTTON_LEFT &&
+       p.dusk.cfg.layout==dusk_native::Layout::Floating &&
+       p.dusk.cfg.auxiliary && dusk_native::contains(g.top,x,y)) {
+        p.dusk.dragging=true; p.dusk.drag_dx=int(x)-g.top.x;
+        p.dusk.drag_dy=int(y)-g.top.y;
+        return true;
+    }
+    return (down||up) && ev.button.button==SDL_BUTTON_LEFT && y<g.toolbar.h;
 }
